# Copy to .env. Keep real credentials private and never commit .env.
PAYENGINE_BASE_URL=https://sandbox.bankingcomponent.com/payengine/v1
PAYENGINE_API_KEY=
PAYENGINE_BEARER_TOKEN=
# Documentation is inconsistent: api-key | bearer | both
PAYENGINE_AUTH_MODE=both
# Documentation disagrees on transfer payload: nested | flat
PAYENGINE_TRANSFER_PAYLOAD_MODE=nested
# true forces simulation; without credentials the app automatically uses mock mode
MOCK_MODE=false
API_PORT=8787
